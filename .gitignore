# Exactly one lockfile. Turbopack picks the project root by looking for one, and
# `npm ci` on the Linux deploy box would happily use a stray package-lock.json
# instead of pnpm-lock.yaml (RIC-240). An accidental `npm install` still writes
# this file — this keeps it from ever being committed alongside pnpm's.
package-lock.json
yarn.lock
