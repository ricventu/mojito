{
  "name": "@mojito/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --external better-sqlite3 --external node-pty",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@hono/node-server": "^2.1.5",
    "@mojito/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsup": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
