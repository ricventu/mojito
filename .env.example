MOJITO_PORT=4711
MOJITO_TOKEN=change-me
LINEAR_API_KEY=lin_api_...
# optional overrides:
# MOJITO_PROJECTS=/Users/me/.config/mojito/projects.json
# MOJITO_STATE_DIR=/Users/me/.mojito-state
# Show "Pull & deploy" (Settings + the self row in Stacks). It deploys through
# `make deploy` in a transient systemd unit on Linux (the server must run as the
# mojito.service user unit), or `make prod` / the LaunchAgent on macOS.
# MOJITO_SELF_UPDATE=1
