[Unit]
Description=Mojito v2
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/mojito-v2
# No EnvironmentFile: the server reads <repoRoot>/.env.local itself and scrubs what it adds
# from every child's environment, so the token and the Linear key never reach a session.
# systemd --user starts with a minimal PATH; node and pnpm live in /usr/bin and /usr/local/bin.
# v2 reads MOJITO2_PORT/MOJITO2_HOST only: the shared .env.local carries the old app's
# MOJITO_PORT/MOJITO_HOST, which v2 ignores. Binds 127.0.0.1 by default
# (MOJITO2_HOST); the phone reaches it through Tailscale Serve.
Environment=MOJITO2_PORT=3100
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env pnpm v2:start
Restart=on-failure
RestartSec=3
# tmux sessions are started in a scope of their own (tmux.ts#outsideService), so a restart
# takes the server down and leaves them running.
KillMode=control-group

[Install]
WantedBy=default.target
